# Base Sepolia RPC
RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_RPC_URL=https://sepolia.base.org
# Relayer: pays gas for delegated attestations. Testnet only.
RELAYER_PRIVATE_KEY=0x...
# Synthetic bank attestor: signs statement-window proofs (stand-in for the zkTLS attestor)
BANK_ATTESTOR_PRIVATE_KEY=0x...
NEXT_PUBLIC_BANK_ATTESTOR_ADDRESS=0x...
# Schema UIDs (filled by `npm run schemas`)
NEXT_PUBLIC_SCHEMA_PAYEVENT=0x...
NEXT_PUBLIC_SCHEMA_COUNTERSIGN=0x...
NEXT_PUBLIC_SCHEMA_BANKPROOF=0x...
# Optional: Reclaim zkFetch credentials (real zkTLS path). Leave empty to use the signed attestor.
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=
# Public base URL (for QR links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
